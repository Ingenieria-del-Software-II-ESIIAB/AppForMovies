{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-api",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/AppForMovies.API/AppForMovies.API.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-web",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/AppForMovies.Web/AppForMovies.Web.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test-unit",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/test/AppForMovies.UT/AppForMovies.UT.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test-ui",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/test/AppForMovies.UIT/AppForMovies.UIT.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}